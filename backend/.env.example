# Database Configuration (Neon PostgreSQL in production, SQLite local development default)
DATABASE_URL=sqlite:///data/inkloom.db

# Google Gemini API (Configurable model, free tier supported)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cryptography (Server-side Ed25519 signing key hex, or automatically generated and persisted)
ED25519_PRIVATE_KEY=

# CORS & Client Target
FRONTEND_URL=http://localhost:5173

# Demo Mode Enabled
DEMO_MODE=true
